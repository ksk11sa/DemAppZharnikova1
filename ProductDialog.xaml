<Window x:Class="DemAppZharnikova.ProductDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товар" Height="560" Width="460"
        WindowStartupLocation="CenterOwner"
        Icon="/Icon.ico">
    <ScrollViewer>
        <StackPanel Margin="10">
            <TextBlock Text="Артикул:"/>
            <TextBox x:Name="TbArt"/>
            <TextBlock Text="Наименование:"/>
            <TextBox x:Name="TbName"/>
            <TextBlock Text="Ед. изм.:"/>
            <TextBox x:Name="TbUnit"/>
            <TextBlock Text="Цена:"/>
            <TextBox x:Name="TbPrice"/>
            <TextBlock Text="Поставщик:"/>
            <TextBox x:Name="TbSupplier"/>
            <TextBlock Text="Производитель:"/>
            <TextBox x:Name="TbMaker"/>
            <TextBlock Text="Категория:"/>
            <TextBox x:Name="TbCategory"/>
            <TextBlock Text="Скидка %:"/>
            <TextBox x:Name="TbDiscount"/>
            <TextBlock Text="Кол-во:"/>
            <TextBox x:Name="TbStock"/>
            <TextBlock Text="Описание:"/>
            <TextBox x:Name="TbDesc" AcceptsReturn="True" Height="60"/>
            <TextBlock Text="Фото:"/>
            <TextBox x:Name="TbPhoto"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Сохранить" Background="{StaticResource BgAction}" Click="Save_Click"/>
                <Button Content="Отмена" Click="Cancel_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>