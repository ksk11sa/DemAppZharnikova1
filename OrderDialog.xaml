<Window x:Class="DemAppZharnikova.OrderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заказ" Height="480" Width="460"
        WindowStartupLocation="CenterOwner"
        Icon="/Icon.ico">
    <StackPanel Margin="10">
        <TextBlock Text="Номер:"/>
        <TextBox x:Name="TbNumber"/>
        <TextBlock Text="Артикул заказа:"/>
        <TextBox x:Name="TbItems"/>
        <TextBlock Text="Дата заказа:"/>
        <TextBox x:Name="TbDate"/>
        <TextBlock Text="Дата доставки:"/>
        <TextBox x:Name="TbDelivery"/>
        <TextBlock Text="Пункт выдачи:"/>
        <TextBox x:Name="TbPickup"/>
        <TextBlock Text="Клиент:"/>
        <TextBox x:Name="TbClient"/>
        <TextBlock Text="Код:"/>
        <TextBox x:Name="TbCode"/>
        <TextBlock Text="Статус:"/>
        <TextBox x:Name="TbStatus"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Сохранить" Background="{StaticResource BgAction}" Click="Save_Click"/>
            <Button Content="Отмена" Click="Cancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
