<Window x:Class="DemAppZharnikova.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация — ООО «Обувь»"
        Height="480" Width="820"
        WindowStartupLocation="CenterScreen"
       Icon="/Icon.ico">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Image Source="/Icon.ico" Width="200" Height="200" Stretch="Uniform"/>
            <TextBlock Text="ООО «Обувь»" FontSize="24" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,10,0,0"/>
        </StackPanel>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20">
            <TextBlock Text="Вход в систему" FontSize="22" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,20"/>
            <TextBlock Text="Логин:" FontSize="16"/>
            <TextBox x:Name="TbLogin" Height="30" Margin="0,5,0,15" FontSize="14"/>
            <TextBlock Text="Пароль:" FontSize="16"/>
            <PasswordBox x:Name="PbPassword" Height="30" Margin="0,5,0,15" FontSize="14"/>
            <Button x:Name="BtnLogin" Content="Войти" Height="40"
                    Background="{StaticResource BgAction}" FontSize="16" FontWeight="Bold"
                    Click="BtnLogin_Click"/>
            <Button x:Name="BtnGuest" Content="Продолжить как гость" Height="40"
                    Background="{StaticResource BgExtra}" FontSize="16"
                    Click="BtnGuest_Click"/>
            <TextBlock x:Name="TbError" Foreground="Red" FontSize="14"
                       Margin="0,10,0,0" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>