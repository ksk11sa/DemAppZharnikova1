<Window x:Class="DemAppZharnikova.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ООО «Обувь» — Товары"
        Height="720" Width="1200"
        WindowStartupLocation="CenterScreen"
        Icon="/Icon.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="{StaticResource BgExtra}" Padding="10">
            <DockPanel>
                <TextBlock x:Name="TbUserInfo" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text="ООО «Обувь»" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>

        <!-- Панель фильтров -->
        <StackPanel x:Name="FilterPanel" Grid.Row="1" Orientation="Horizontal"
                    Margin="10,5,10,5" Visibility="Collapsed">
            <TextBlock Text="Поиск:" VerticalAlignment="Center" FontSize="14"/>
            <TextBox x:Name="TbSearch" Width="180" Margin="5,0,15,0" FontSize="14"
                     TextChanged="TbSearch_TextChanged"/>

            <TextBlock Text="Категория:" VerticalAlignment="Center" FontSize="14"/>
            <ComboBox x:Name="CbCategory" Width="160" Margin="5,0,15,0" FontSize="14"
                      SelectionChanged="CbCategory_SelectionChanged"/>

            <TextBlock Text="Сортировка:" VerticalAlignment="Center" FontSize="14"/>
            <ComboBox x:Name="CbSort" Width="160" Margin="5,0,0,0" FontSize="14" IsEditable="False"
                      SelectionChanged="CbSort_SelectionChanged">
                <ComboBoxItem Content="Без сортировки" IsSelected="True"/>
                <ComboBoxItem Content="Цена ↑"/>
                <ComboBoxItem Content="Цена ↓"/>
                <ComboBoxItem Content="Скидка ↑"/>
                <ComboBoxItem Content="Скидка ↓"/>
            </ComboBox>
        </StackPanel>

        <!-- Таблица -->
        <DataGrid x:Name="DgProducts" Grid.Row="2"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" HeadersVisibility="Column"
                  CanUserSortColumns="False" 
                  Margin="10,0,10,5" FontSize="13"
                  RowBackground="White">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Артикул"          Binding="{Binding [Article]}" Width="90"/>
                <DataGridTextColumn Header="Наименование"     Binding="{Binding [Name]}" Width="130"/>
                <DataGridTextColumn Header="Ед."              Binding="{Binding [Unit]}" Width="50"/>
                <DataGridTextColumn Header="Цена"             Binding="{Binding [Price]}" Width="80"/>
                <DataGridTextColumn Header="Скидка %"         Binding="{Binding [Discount]}" Width="80"/>
                <DataGridTextColumn Header="Цена со скидкой"  Binding="{Binding [FinalPrice]}" Width="110"/>
                <DataGridTextColumn Header="Кол-во"           Binding="{Binding [Stock]}" Width="70"/>
                <DataGridTextColumn Header="Категория"        Binding="{Binding [Category]}" Width="120"/>
                <DataGridTextColumn Header="Поставщик"        Binding="{Binding [Supplier]}" Width="120"/>
                <DataGridTextColumn Header="Производитель"    Binding="{Binding [Manufacturer]}" Width="130"/>
                <DataGridTextColumn Header="Описание"         Binding="{Binding [Description]}" Width="*"/>

                <DataGridTemplateColumn Header="Фото" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Width="50" Height="50" Stretch="Uniform"
                   Source="{Binding [ImagePath]}"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   ImageFailed="ImgPhoto_ImageFailed"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="White"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding [HasBigDiscount]}" Value="True">
                            <Setter Property="Background" Value="#2E8B57"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="LightGray"/>
                            <Setter Property="Foreground" Value="Black"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
        </DataGrid>

        <!-- Кнопки -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="10" HorizontalAlignment="Right">
            <Button Content="Назад"           Background="{StaticResource BgExtra}"  Click="BtnBack_Click"/>
            <Button x:Name="BtnOrders" Content="Заказы" Background="{StaticResource BgExtra}"
                    Click="BtnOrders_Click" Visibility="Collapsed"/>
            <Button x:Name="BtnAdd"    Content="Добавить"      Background="{StaticResource BgAction}"
                    Click="BtnAdd_Click"    Visibility="Collapsed"/>
            <Button x:Name="BtnEdit"   Content="Редактировать" Background="{StaticResource BgAction}"
                    Click="BtnEdit_Click"   Visibility="Collapsed"/>
            <Button x:Name="BtnDelete" Content="Удалить"       Background="{StaticResource BgAction}"
                    Click="BtnDelete_Click" Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</Window>