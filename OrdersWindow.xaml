<Window x:Class="DemAppZharnikova.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ООО «Обувь» — Заказы" Height="600" Width="1100"
        WindowStartupLocation="CenterScreen"
        Icon="/Icon.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BgExtra}" Padding="10">
            <TextBlock Text="Список заказов" FontSize="18" FontWeight="Bold"/>
        </Border>

        <DataGrid x:Name="DgOrders" Grid.Row="1" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" Margin="10"
                  FontSize="13">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Номер"          Binding="{Binding [Number]}" Width="70"/>
                <DataGridTextColumn Header="Артикул заказа" Binding="{Binding [Items]}" Width="260"/>
                <DataGridTextColumn Header="Дата заказа"    Binding="{Binding [OrderDate]}" Width="110"/>
                <DataGridTextColumn Header="Дата доставки"  Binding="{Binding [DeliveryDate]}" Width="110"/>
                <DataGridTextColumn Header="Пункт выдачи"   Binding="{Binding [Pickup]}" Width="110"/>
                <DataGridTextColumn Header="Клиент"         Binding="{Binding [Client]}" Width="*"/>
                <DataGridTextColumn Header="Код"            Binding="{Binding [Code]}" Width="70"/>
                <DataGridTextColumn Header="Статус"         Binding="{Binding [Status]}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <Button Content="Назад" Background="{StaticResource BgExtra}" Click="BtnBack_Click"/>
            <Button x:Name="BtnAdd"    Content="Добавить"      Background="{StaticResource BgAction}" Click="BtnAdd_Click"    Visibility="Collapsed"/>
            <Button x:Name="BtnEdit"   Content="Редактировать" Background="{StaticResource BgAction}" Click="BtnEdit_Click"   Visibility="Collapsed"/>
            <Button x:Name="BtnDelete" Content="Удалить"       Background="{StaticResource BgAction}" Click="BtnDelete_Click" Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</Window>
